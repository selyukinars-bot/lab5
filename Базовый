<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Мини-калькулятор</title>
</head>
<body>

    <h2>Мини-калькулятор</h2>

    <input type="number" id="num1" placeholder="Первое число">
    <input type="number" id="num2" placeholder="Второе число">

    <br><br>

    <button onclick="add()">Сложить</button>
    <button onclick="subtract()">Вычесть</button>

    <h3 id="result">Результат: </h3>

    <script>
        function add() {
            let a = Number(document.getElementById("num1").value);
            let b = Number(document.getElementById("num2").value);

            document.getElementById("result").textContent =
                "Результат: " + (a + b);
        }

        function subtract() {
            let a = Number(document.getElementById("num1").value);
            let b = Number(document.getElementById("num2").value);

            document.getElementById("result").textContent =
                "Результат: " + (a - b);
        }
    </script>

</body>
</html>
